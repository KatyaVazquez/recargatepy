# Copiar a .env.local y completar con valores reales.
# .env.local nunca se sube al repo (ver .gitignore).

# ─── Supabase ────────────────────────────────────────────────────────────────
# Sacar de Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=<REDACTED>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<REDACTED>
SUPABASE_SECRET_KEY=<REDACTED>

# ─── App ─────────────────────────────────────────────────────────────────────
# URL pública. En dev típicamente http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Telegram ────────────────────────────────────────────────────────────────
# Token del bot del PRIMER tenant durante dev (en producción los tokens viven
# encriptados en la tabla `tenants`, uno por cliente).
TELEGRAM_BOT_TOKEN=<REDACTED>
# Secret aleatorio para validar webhooks de Telegram (header X-Telegram-Bot-Api-Secret-Token).
# Generar con: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=<REDACTED>

# ─── Misc ────────────────────────────────────────────────────────────────────
# telegram_id del admin (opcional), para alertas de uptime
SUPER_ADMIN_TELEGRAM_ID=

# Secret para firmar links de la PWA (generar con: openssl rand -hex 32)
OPERADOR_TOKEN_SECRET=<REDACTED>
